# Backend configuration. Copy to .env in the repository root.
# Supply your own keys locally; never commit .env.
GEMINI_API_KEY=
# Required for voice playback; typed chat does not require this key.
OPENROUTER_API_KEY=

# Optional overrides matching the source-code defaults.
PLANNER_MODEL=gemini-3.5-flash-lite
PLANNER_FALLBACK_MODEL=gemini-3.1-flash-lite
# Knowledge/RAG generation AND image/scanned-PDF extraction.
GEMINI_MODEL=gemini-2.5-flash

# Relative to the repository root when using the README commands.
KB_DIR=knowledge_base
KB_INDEX_DIR=data/faiss_index
# Rebuild the index after changing the embedding model or Markdown content.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=5
RAG_MIN_SCORE=0.15
